# Response headers for the static assets (Cloudflare Workers static assets apply this file). ADR-019/020: the app
# talks to its own origin (static data + sharing/reports API), its sibling Workers (reports feed, basemap), the Nostr
# relays of the overflow paths and OpenFreeMap (fallback map) — `connect-src` below is rewritten at build time from
# the build's VITE_* values (vite.config.ts, cspConnectSrc).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Our data (ADR-019). Files inside a build or run folder never change (a new build gets a new folder): cached for good.
/data/roads/*
  Cache-Control: public, max-age=31536000, immutable

/data/search/*
  Cache-Control: public, max-age=31536000, immutable

/data/weather/runs/*
  Cache-Control: public, max-age=31536000, immutable

/data/air/runs/*
  Cache-Control: public, max-age=31536000, immutable

# Not versioned by folder: kept a day, then revalidated.
/data/places/*
  Cache-Control: public, max-age=86400

/data/elev/*
  Cache-Control: public, max-age=86400

# Which build is current: always revalidated (small).
/data/roads.json
  Cache-Control: no-cache

/data/search.json
  Cache-Control: no-cache

/data/weather/latest.json
  Cache-Control: no-cache

/data/air/latest.json
  Cache-Control: no-cache
