{
  "name": "navweather",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Know the weather before you reach it — forecast along your driving route at your estimated arrival time.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:phone": "node scripts/dev.mjs --phone",
    "dev:web": "vite",
    "dev:api": "node scripts/worker-assets.mjs && wrangler dev --port 8787 --ip 127.0.0.1 --assets .wrangler/dev-assets",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && vite build --mode preview",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev --port 8787 --ip 127.0.0.1",
    "typecheck": "tsc -b --noEmit && tsc -p worker && tsc -p e2e",
    "check:envs": "node scripts/check-wrangler-envs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_API_TESTS=1 vitest run src/integration/live.test.ts",
    "test:share": "node scripts/share-smoke.mjs",
    "test:reports": "node scripts/reports-smoke.mjs",
    "deploy:preview": "npm run build:preview && wrangler deploy --env preview",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "e2e": "playwright test",
    "data:borders": "node pipelines/borders/build.mjs",
    "data:download": "node pipelines/osm/download.mjs",
    "data:osm": "node --experimental-strip-types --no-warnings pipelines/osm/build.mjs",
    "data:weather": "node --experimental-strip-types --no-warnings pipelines/weather/build.mjs",
    "data:elevation": "node --experimental-strip-types --no-warnings pipelines/elevation/build.mjs",
    "data:air": "node --experimental-strip-types --no-warnings pipelines/air/build.mjs",
    "data:roads": "node --experimental-strip-types --no-warnings --max-old-space-size=8192 pipelines/roads/build.mjs",
    "data:all": "npm run data:download && npm run data:osm && npm run data:roads && npm run data:elevation && npm run data:weather && npm run data:air -- --max-mb 60"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "11.7.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@openmeteo/file-reader": "^0.0.21",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}
