<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Simulator builds only (CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]): lets the app appear on Xcode's CarPlay
  screen (Simulator → I/O → External Displays → CarPlay) at no cost. A real car shows the app only when it is
  signed with Apple's CarPlay navigation entitlement, which Apple grants on request to paid Developer Program
  members (REQ-PLAT-004, ADR-015) — device builds therefore carry no entitlements file.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.carplay-maps</key>
    <true/>
</dict>
</plist>
